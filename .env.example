POSTGRES_DB=regional
POSTGRES_USER=regional
POSTGRES_PASSWORD=change-this-local-password
DATABASE_URL=postgresql+psycopg://regional:change-this-local-password@db:5432/regional
API_URL=http://api:8000
CORE_MANAGED_EXTERNALLY=false
RAW_DIR=data/archive
STAT_UPDATES_ENABLED=false
STAT_UPDATE_INTERVAL=86400
# For development without Docker: change db to localhost in DATABASE_URL,
# and set API_URL=http://localhost:8000. Keep secrets only in untracked .env.
# CI integration tests use TEST_DATABASE_URL with database regional_ci_test.
